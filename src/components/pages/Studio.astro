---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = Astro.currentLocale || 'it';
const t = useTranslations(lang as any);
---

<Layout title={t('nav.studio')}>
	<div class="page-header">
		<div class="container header-content reveal">
			<h1>{t('studio.title.1')} <span>{t('studio.title.2')}</span></h1>
			<div class="divider"></div>
			<p>{t('studio.subtitle')}</p>
		</div>
	</div>

	<section class="studio-content container">
		<div class="content-block reveal delay-1">
			<h2>{t('studio.intro.title')}</h2>
			<p>{t('studio.intro.p1')}</p>
			<p>{t('studio.intro.p2')}</p>
		</div>

		<div class="content-block highlight reveal delay-2">
			<h2>{t('studio.exp.title')}</h2>
			<p>{t('studio.exp.p1')}</p>
			<p>{t('studio.exp.p2')}</p>
			<ul>
				<li>{t('studio.exp.li1')}</li>
				<li>{t('studio.exp.li2')}</li>
				<li>{t('studio.exp.li3')}</li>
				<li>{t('studio.exp.li4')}</li>
			</ul>
		</div>

		<div class="content-block reveal delay-3">
			<h2>{t('studio.why.title')}</h2>
			<p>{t('studio.why.p1')}</p>
			<p><strong>{t('studio.why.p2')}</strong></p>
		</div>
	</section>
</Layout>

<style>
	.page-header {
		padding: 12rem 0 6rem;
		background-color: var(--color-primary-dark);
		text-align: center;
	}

	.header-content h1 {
		font-size: 3.5rem;
		color: var(--color-white);
		margin-bottom: 1.5rem;
	}
	
	.header-content h1 span {
		font-style: italic;
		color: var(--color-secondary);
	}

	.divider {
		width: 60px;
		height: 3px;
		background-color: var(--color-secondary);
		margin: 0 auto 2rem;
	}

	.header-content p {
		font-size: 1.2rem;
		color: rgba(255, 255, 255, 0.8);
		max-width: 600px;
		margin: 0 auto;
	}

	.studio-content {
		padding-top: 6rem;
		padding-bottom: 8rem;
		max-width: 800px;
		margin: 0 auto;
	}

	.content-block {
		margin-bottom: 4rem;
	}

	.content-block h2 {
		font-size: 2.2rem;
		margin-bottom: 1.5rem;
		color: var(--color-primary-dark);
	}

	.content-block p {
		font-size: 1.1rem;
		color: var(--color-text-light);
		margin-bottom: 1.2rem;
		line-height: 1.8;
	}

	.highlight {
		background: var(--color-white);
		padding: 3rem;
		border-radius: 8px;
		border-left: 4px solid var(--color-secondary);
		box-shadow: 0 10px 30px rgba(0,0,0,0.03);
	}

	.highlight ul {
		list-style: none;
		margin-top: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.highlight li {
		position: relative;
		padding-left: 1.5rem;
		color: var(--color-text-light);
		line-height: 1.5;
	}

	.highlight li::before {
		content: "•";
		color: var(--color-secondary);
		position: absolute;
		left: 0;
		font-size: 1.2rem;
		line-height: 1.2;
	}

	@media (max-width: 768px) {
		.page-header {
			padding: 10rem 0 4rem;
		}
		.header-content h1 {
			font-size: 2.5rem;
		}
		.highlight {
			padding: 2rem;
		}
	}
</style>

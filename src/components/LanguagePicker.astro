---
import { languages } from '../i18n/ui';

const currentLocale = Astro.currentLocale || 'it';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Rimuovi il prefisso della lingua e il base path dall'URL corrente per ottenere la rotta pulita
let rawPath = Astro.url.pathname;
if (base && rawPath.startsWith(base)) {
  rawPath = rawPath.substring(base.length);
}
// Rimuovi eventuale /ro/
if (rawPath.startsWith('/ro/')) {
  rawPath = rawPath.substring(3);
} else if (rawPath === '/ro') {
  rawPath = '/';
}

if (!rawPath.startsWith('/')) rawPath = '/' + rawPath;
---
<div class="lang-picker">
  {Object.entries(languages).map(([lang, label]) => {
    const prefix = lang === 'it' ? '' : `/${lang}`;
    let targetUrl = `${base}${prefix}${rawPath}`;
    // Pulisci doppi slash
    targetUrl = targetUrl.replace(/\/\//g, '/');
    if (targetUrl === '') targetUrl = '/';
    
    return (
      <a href={targetUrl} class={currentLocale === lang ? 'active' : ''} title={label}>
        {lang.toUpperCase()}
      </a>
    );
  })}
</div>

<style>
  .lang-picker {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    margin-left: 1.5rem;
    border-left: 1px solid rgba(255,255,255,0.2);
    padding-left: 1.5rem;
  }
  .lang-picker a {
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.3s ease;
  }
  .lang-picker a.active, .lang-picker a:hover {
    color: var(--color-white);
  }
  
  /* Stili quando l'header è scrolled (testo scuro) */
  :global(header.scrolled) .lang-picker {
    border-left: 1px solid rgba(0,0,0,0.1);
  }
  :global(header.scrolled) .lang-picker a {
    color: var(--color-text-light);
  }
  :global(header.scrolled) .lang-picker a.active, :global(header.scrolled) .lang-picker a:hover {
    color: var(--color-primary-dark);
  }
  
  @media (max-width: 768px) {
    .lang-picker {
      margin-left: 0;
      border-left: none;
      padding-left: 0;
      margin-top: 1rem;
      justify-content: center;
    }
  }
</style>

---
import '../styles/global.css';

interface Props {
	title: string;
}

import LanguagePicker from '../components/LanguagePicker.astro';
import { useTranslations } from '../i18n/utils';

const { title } = Astro.props;
const lang = Astro.currentLocale || 'it';
const t = useTranslations(lang as any);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'it' ? '' : `/${lang}`;
const baseUrl = `${base}${prefix}`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Studio Tributario Doina Bragoi - Consulenza Fiscale, Societaria e del Lavoro. Servizi premium per imprese e professionisti." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
		<title>{title} | Studio LTax</title>
	</head>
	<body>
		<header id="main-header">
			<div class="container header-inner">
				<a href={baseUrl || '/'} class="logo">
					<img src={`${base}/header-logo.png`} alt="Studio LTax Logo" class="header-logo" />
				</a>
				<button class="mobile-menu-toggle" aria-label="Menu">
					<span></span>
					<span></span>
					<span></span>
				</button>
				<nav id="main-nav">
					<ul>
						<li><a href={baseUrl || '/'}>{t('nav.home')}</a></li>
						<li><a href={`${baseUrl}/lo-studio`}>{t('nav.studio')}</a></li>
						<li><a href={`${baseUrl}/servizi`}>{t('nav.servizi')}</a></li>
						<li><a href={`${baseUrl}/prenota`} class="btn">{t('nav.prenota')}</a></li>
						<LanguagePicker />
					</ul>
					<div class="mobile-menu-footer">
						<p><a href="tel:+393298188662">+39 3298188662</a></p>
						<p><a href="mailto:doinabragoi@gmail.com">doinabragoi@gmail.com</a></p>
					</div>
				</nav>
			</div>
		</header>
		
		<main>
			<slot />
		</main>

		<footer class="main-footer">
			<div class="footer-background-text">LTAX</div>
			<div class="container footer-inner">
				<div class="footer-brand reveal">
					<h3 class="footer-logo-text">Studio LTax</h3>
					<p class="footer-tagline">{t('hero.subtitle')}</p>
					<div class="footer-socials">
						<a href="https://linkedin.com/in/doina-bragoi" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
						</a>
						<a href="https://www.instagram.com/doinabragoi" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
						</a>
						<a href="https://www.tiktok.com/@doina.bragoi/" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
						</a>
						<a href="https://www.facebook.com/p/Doina-Bragoi-61573939461677/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
						</a>
					</div>
				</div>
				<div class="footer-section reveal delay-1">
					<h4>Studio</h4>
					<p>Bovolone (VR)</p>
					<p>Tributarista INT (n. 3043)</p>
					<p>Intermediario fiscale abilitato</p>
					<p>P.IVA: 05122570236</p>
				</div>
				<div class="footer-section reveal delay-2">
					<h4>Contatti</h4>
					<p><a href="tel:+393298188662" class="footer-link-hover">+39 3298188662</a></p>
					<p><a href="mailto:doinabragoi@gmail.com" class="footer-link-hover">doinabragoi@gmail.com</a></p>
				</div>
				<div class="footer-section reveal delay-3">
					<h4>{t('footer.links')}</h4>
					<nav class="footer-nav">
						<a href={baseUrl || '/'}>{t('nav.home')}</a>
						<a href={`${baseUrl}/lo-studio`}>{t('nav.studio')}</a>
						<a href={`${baseUrl}/servizi`}>{t('nav.servizi')}</a>
						<a href={`${base}/admin`}>{t('footer.cms')}</a>
					</nav>
				</div>
			</div>
			<div class="container">
				<div class="footer-bottom reveal delay-3">
					<div class="footer-bottom-flex">
						<p>&copy; {new Date().getFullYear()} Studio LTax. Tutti i diritti riservati.</p>
						<div class="footer-legal">
							<a href="#">Privacy Policy</a>
							<a href="#">Cookie Policy</a>
						</div>
					</div>
				</div>
			</div>
		</footer>

		<script>
			// Sticky Header
			const header = document.getElementById('main-header');
			const handleScroll = () => {
				if (window.scrollY > 50) {
					header?.classList.add('scrolled');
				} else {
					header?.classList.remove('scrolled');
				}
			};
			window.addEventListener('scroll', handleScroll);
			// Check scroll position on page load
			handleScroll();

			// Mobile Menu
			const toggle = document.querySelector('.mobile-menu-toggle');
			const nav = document.getElementById('main-nav');
			
			toggle?.addEventListener('click', () => {
				toggle.classList.toggle('open');
				nav?.classList.toggle('open');
				document.body.classList.toggle('no-scroll');
			});

			// Scroll Reveals
			function reveal() {
				const reveals = document.querySelectorAll('.reveal');
				for (let i = 0; i < reveals.length; i++) {
					const windowHeight = window.innerHeight;
					const elementTop = reveals[i].getBoundingClientRect().top;
					const elementVisible = 100;
					if (elementTop < windowHeight - elementVisible) {
						reveals[i].classList.add('active');
					}
				}
			}
			window.addEventListener('scroll', reveal);
			// Trigger once on load
			setTimeout(reveal, 100);
		</script>
	</body>
</html>

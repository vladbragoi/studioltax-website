---
import '../styles/global.css';

interface Props {
	title: string;
}

import LanguagePicker from '../components/LanguagePicker.astro';
import { useTranslations } from '../i18n/utils';

const { title } = Astro.props;
const lang = Astro.currentLocale || 'it';
const t = useTranslations(lang as any);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'it' ? '' : `/${lang}`;
const baseUrl = `${base}${prefix}`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Studio Tributario Doina Bragoi - Consulenza Fiscale, Societaria e del Lavoro. Servizi premium per imprese e professionisti." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
		<title>{title} | Studio LTax</title>
	</head>
	<body>
		<header id="main-header">
			<div class="container header-inner">
				<a href={baseUrl || '/'} class="logo">
					<img src={`${base}/header-logo.png`} alt="Studio LTax Logo" class="header-logo" />
				</a>
				<button class="mobile-menu-toggle" aria-label="Menu">
					<span></span>
					<span></span>
					<span></span>
				</button>
				<nav id="main-nav">
					<ul>
						<li><a href={baseUrl || '/'}>{t('nav.home')}</a></li>
						<li><a href={`${baseUrl}/servizi`}>{t('nav.servizi')}</a></li>
						<li><a href={`${baseUrl}/prenota`} class="btn">{t('nav.prenota')}</a></li>
						<LanguagePicker />
					</ul>
				</nav>
			</div>
		</header>
		
		<main>
			<slot />
		</main>

		<footer>
			<div class="container footer-inner">
				<div class="footer-section reveal">
					<h4>Studio LTax</h4>
					<p>BOVOLONE (VR)</p>
					<p>Tributarista iscritta al n. 3043 dell'INT.</p>
					<p>Abilitata intermediario fiscale.</p>
				</div>
				<div class="footer-section reveal delay-1">
					<h4>Contatti</h4>
					<p>Tel: <a href="tel:+393298188662">+39 3298188662</a></p>
					<p>Email: <a href="mailto:doinabragoi@gmail.com">doinabragoi@gmail.com</a></p>
					<p>P.IVA: 05122570236</p>
				</div>
				<div class="footer-section reveal delay-2">
					<h4>{t('footer.links')}</h4>
					<p><a href={`${baseUrl}/servizi`}>{t('footer.all_services')}</a></p>
					<p><a href={`${baseUrl}/prenota`}>{t('nav.prenota')}</a></p>
					<p><a href={`${base}/admin`}>{t('footer.cms')}</a></p>
				</div>
			</div>
			<div class="container">
				<div class="footer-bottom reveal delay-3">
					&copy; {new Date().getFullYear()} Studio LTax. Tutti i diritti riservati.
				</div>
			</div>
		</footer>

		<script>
			// Sticky Header
			window.addEventListener('scroll', () => {
				const header = document.getElementById('main-header');
				if (window.scrollY > 50) {
					header?.classList.add('scrolled');
				} else {
					header?.classList.remove('scrolled');
				}
			});

			// Mobile Menu
			const toggle = document.querySelector('.mobile-menu-toggle');
			const nav = document.getElementById('main-nav');
			
			toggle?.addEventListener('click', () => {
				toggle.classList.toggle('open');
				nav?.classList.toggle('open');
			});

			// Scroll Reveals
			function reveal() {
				const reveals = document.querySelectorAll('.reveal');
				for (let i = 0; i < reveals.length; i++) {
					const windowHeight = window.innerHeight;
					const elementTop = reveals[i].getBoundingClientRect().top;
					const elementVisible = 100;
					if (elementTop < windowHeight - elementVisible) {
						reveals[i].classList.add('active');
					}
				}
			}
			window.addEventListener('scroll', reveal);
			// Trigger once on load
			setTimeout(reveal, 100);
		</script>
	</body>
</html>

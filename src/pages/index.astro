---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
	<section class="hero">
		<div class="hero-overlay"></div>
		<div class="container hero-content">
			<div class="hero-text reveal">
				<h1>Consulenza Fiscale di <span>Eccellenza</span></h1>
				<p>La tua partner di fiducia per far crescere il tuo business in totale sicurezza.</p>
				<div class="hero-actions">
					<a href={`${import.meta.env.BASE_URL}servizi`} class="btn btn-outline">Scopri i Servizi</a>
					<a href={`${import.meta.env.BASE_URL}prenota`} class="btn">Prenota Appuntamento</a>
				</div>
			</div>
			<div class="hero-image reveal delay-1">
				<img src={`${import.meta.env.BASE_URL}logo.png`} alt="Studio LTax Logo" class="hero-logo-img" />
			</div>
		</div>
	</section>

	<section class="about container">
		<div class="about-grid">
			<div class="about-text reveal">
				<h2>Chi è Doina</h2>
				<div class="divider"></div>
				<p>
					Sono una Tributarista iscritta all'INT, con abilitazione come intermediario fiscale. 
					La mia missione è semplificare la complessità fiscale per liberi professionisti e aziende, 
					offrendo un servizio premium, preciso e sempre aggiornato.
				</p>
				<p>
					Affidarsi allo Studio LTax significa avere la certezza di un consulente sempre al tuo fianco.
				</p>
			</div>
			<div class="about-stats reveal delay-2">
				<div class="stat-card">
					<h3>10+</h3>
					<p>Anni di Esperienza</p>
				</div>
				<div class="stat-card">
					<h3>100%</h3>
					<p>Professionalità Garantita</p>
				</div>
			</div>
		</div>
	</section>

</Layout>

<style>
	/* HERO SECTION */
	.hero {
		position: relative;
		min-height: 100vh;
		background-color: var(--color-primary-dark);
		display: flex;
		align-items: center;
		padding-top: 80px;
		overflow: hidden;
	}

	.hero-overlay {
		position: absolute;
		top: 0; left: 0; right: 0; bottom: 0;
		background: radial-gradient(circle at 70% 50%, rgba(105, 24, 38, 0.4) 0%, var(--color-primary-dark) 80%);
		z-index: 1;
	}

	.hero-content {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
	}

	.hero-text h1 {
		color: var(--color-white);
		font-size: 4.5rem;
		line-height: 1.1;
		margin-bottom: 1.5rem;
		font-weight: 400;
	}

	.hero-text h1 span {
		font-style: italic;
		color: var(--color-accent-light);
	}

	.hero-text p {
		color: rgba(255, 255, 255, 0.8);
		font-size: 1.25rem;
		margin-bottom: 2.5rem;
		max-width: 450px;
		font-weight: 300;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
	}

	.hero-image {
		display: flex;
		justify-content: center;
		align-items: center;
		position: relative;
	}

	.hero-logo-img {
		max-width: 100%;
		height: auto;
		max-height: 450px;
		position: relative;
		z-index: 2;
		filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.4));
		animation: float 6s ease-in-out infinite;
	}

	@keyframes float {
		0% { transform: translateY(0px); }
		50% { transform: translateY(-15px); }
		100% { transform: translateY(0px); }
	}

	/* ABOUT SECTION */
	.about {
		padding: 8rem 2rem;
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 6rem;
		align-items: center;
	}

	.about-text h2 {
		font-size: 3rem;
		margin-bottom: 1.5rem;
		color: var(--color-primary-dark);
	}

	.divider {
		width: 60px;
		height: 3px;
		background-color: var(--color-secondary);
		margin-bottom: 2rem;
	}

	.about-text p {
		font-size: 1.15rem;
		color: var(--color-text-light);
		margin-bottom: 1.5rem;
		font-weight: 300;
	}

	.about-stats {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	.stat-card {
		background: var(--color-white);
		padding: 3rem;
		border-radius: 4px;
		text-align: center;
		box-shadow: 0 15px 30px rgba(0, 0, 0, 0.04);
		border-left: 4px solid var(--color-primary);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.stat-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
	}

	.stat-card h3 {
		font-size: 3.5rem;
		color: var(--color-primary);
		margin-bottom: 0.5rem;
		font-family: var(--font-base);
		font-weight: 300;
	}

	.stat-card p {
		color: var(--color-text-light);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 1px;
		font-size: 0.85rem;
	}

	@media (max-width: 992px) {
		.hero-content, .about-grid {
			grid-template-columns: 1fr;
			text-align: center;
		}
		
		.hero-text h1 { font-size: 3.5rem; }
		.hero-text p { margin: 0 auto 2.5rem; }
		.hero-actions { justify-content: center; }
		.divider { margin: 0 auto 2rem; }
	}
</style>

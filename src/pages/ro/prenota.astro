---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = Astro.currentLocale || 'it';
const t = useTranslations(lang as any);
---

<Layout title={t('nav.prenota')}>
	<div class="page-header">
		<div class="container header-content reveal">
			<h1>{t('prenota.title.1')} <span>{t('prenota.title.2')}</span></h1>
			<div class="divider"></div>
			<p>{t('prenota.subtitle')}</p>
		</div>
	</div>

	<section class="booking-container container">
		<div class="booking-grid">
			<div class="booking-info reveal delay-2">
				<h2>{t('prenota.info.title')}</h2>
				<p>{t('prenota.info.p')}</p>
				
				<div class="contact-details">
					<div class="detail-item">
						<strong>{t('prenota.info.sede')}:</strong>
						<span>Via Roma 123, 00100 Roma (RM)</span>
					</div>
					<div class="detail-item">
						<strong>{t('prenota.info.tel')}:</strong>
						<span><a href="tel:+390612345678">+39 06 1234 5678</a></span>
					</div>
					<div class="detail-item">
						<strong>{t('prenota.info.email')}:</strong>
						<span><a href="mailto:info@studioltax.it">info@studioltax.it</a></span>
					</div>
				</div>
			</div>
			
			<div class="calendar-embed reveal delay-3">
				<iframe 
					src="https://calendar.google.com/calendar/appointments/schedules/placeholder-link" 
					style="border: 0" 
					width="100%" 
					height="600" 
					frameborder="0" 
					scrolling="yes">
				</iframe>
				<div class="calendar-fallback">
					<p><i>{t('prenota.calendar.note')}</i></p>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.page-header {
		padding: 12rem 0 6rem;
		background-color: var(--color-primary-dark);
		text-align: center;
	}

	.header-content h1 {
		font-size: 3.5rem;
		color: var(--color-white);
		margin-bottom: 1.5rem;
	}
	
	.header-content h1 span {
		font-style: italic;
		color: var(--color-secondary);
	}

	.divider {
		width: 60px;
		height: 3px;
		background-color: var(--color-secondary);
		margin: 0 auto 2rem;
	}

	.header-content p {
		font-size: 1.2rem;
		color: rgba(255, 255, 255, 0.8);
		max-width: 600px;
		margin: 0 auto;
	}

	.booking-container {
		padding-top: 6rem;
		padding-bottom: 8rem;
	}

	.booking-grid {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 4rem;
	}

	.booking-info h2 {
		font-size: 2rem;
		margin-bottom: 1rem;
		color: var(--color-primary-dark);
	}

	.booking-info p {
		margin-bottom: 2rem;
		color: var(--color-text-light);
	}

	.contact-details {
		background-color: var(--color-bg-light);
		padding: 2rem;
		border-radius: 8px;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		border-left: 4px solid var(--color-primary);
	}

	.detail-item {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.detail-item strong {
		color: var(--color-primary);
	}

	.detail-item a {
		font-weight: 500;
	}

	.calendar-embed {
		background: #fff;
		border-radius: 8px;
		box-shadow: 0 10px 30px rgba(0,0,0,0.05);
		overflow: hidden;
		border: 1px solid var(--color-accent-light);
		position: relative;
	}

	.calendar-fallback {
		padding: 1rem;
		text-align: center;
		background: #fdfaf8;
		border-top: 1px solid var(--color-accent-light);
		color: var(--color-text-light);
	}

	@media (max-width: 900px) {
		.booking-grid {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 768px) {
		.page-header {
			padding: 10rem 0 4rem;
		}
		.header-content h1 {
			font-size: 2.5rem;
		}
	}
</style>
